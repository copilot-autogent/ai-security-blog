---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import PostNav from "../components/PostNav.astro";
import RelatedPosts from "../components/RelatedPosts.astro";
import SubscribeCTA from "../components/SubscribeCTA.astro";
import TableOfContents from "../components/TableOfContents.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

type Props = CollectionEntry<"blog">["data"] & {
  minutesRead?: number;
  id?: string;
  headings?: Heading[];
  prevPost?: CollectionEntry<"blog">;
  nextPost?: CollectionEntry<"blog">;
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  minutesRead,
  tags = [],
  id = "",
  headings = [],
  prevPost,
  nextPost,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<html lang="en">
  <head>
    <BaseHead title={`${title} | AI Security Distilled`} description={description} />
    <style>
      .prose {
        width: 720px;
        max-width: calc(100% - 2em);
        margin: auto;
        padding: 1em;
      }
      .post-header {
        margin-bottom: 2em;
        padding-bottom: 1.5em;
        border-bottom: 1px solid var(--border);
      }
      .post-header h1 {
        margin: 0 0 0.5em 0;
        line-height: 1.2;
      }
      .post-meta {
        color: var(--text-secondary);
        font-size: 0.9em;
        display: flex;
        flex-wrap: wrap;
        gap: 1em;
        align-items: center;
      }
      .tags {
        display: flex;
        gap: 0.5em;
        flex-wrap: wrap;
      }
      .tag {
        background: var(--bg-elevated);
        color: var(--accent);
        padding: 0.15em 0.6em;
        border-radius: 12px;
        font-size: 0.8em;
        border: 1px solid var(--border);
        text-decoration: none;
      }
      .tag:hover {
        background: var(--accent);
        color: var(--bg);
      }
      .updated {
        font-style: italic;
      }
    </style>
  </head>

  <body>
    <Header />
    <main>
      <article>
        <div class="prose">
          <div class="post-header">
            <h1>{title}</h1>
            <div class="post-meta">
              <span>Published <FormattedDate date={pubDate} /></span>
              {minutesRead && <span>{minutesRead} min read</span>}
              {updatedDate && (
                <span class="updated">
                  Updated <FormattedDate date={updatedDate} />
                </span>
              )}
            </div>
            {tags.length > 0 && (
              <div class="tags" style="margin-top: 0.75em;">
                {tags.map((tag) => <a href={`${base}/blog/tags/${encodeURIComponent(tag)}/`} class="tag">{tag}</a>)}
              </div>
            )}
          </div>
          <TableOfContents headings={headings} />
          <slot />
          <PostNav prevPost={prevPost} nextPost={nextPost} />
          <RelatedPosts currentId={id} currentTags={tags} />
          <SubscribeCTA />
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
