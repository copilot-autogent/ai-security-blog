---
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import { SITE_TITLE } from "../../consts";
import { LEARNING_PATHS } from "../../data/learning-paths";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Learning Paths | ${SITE_TITLE}`}
      description="Curated sequences through the AI security post collection — structured curricula from foundations to advanced topics."
    />
    <style>
      .page-header {
        padding: 3em 0 2em;
        border-bottom: 1px solid var(--border);
        margin-bottom: 3em;
      }
      .page-header h1 { font-size: 2em; margin: 0 0 0.4em; }
      .page-header p {
        color: var(--text-secondary);
        font-size: 1.05em;
        margin: 0;
        max-width: 600px;
        line-height: 1.6;
      }
      .breadcrumb {
        font-size: 0.9em;
        color: var(--text-secondary);
        margin-bottom: 2em;
      }
      .breadcrumb a {
        color: var(--text-secondary);
        text-decoration: none;
      }
      .breadcrumb a:hover { color: var(--accent); }
      .paths-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 1.5em;
        margin-bottom: 4em;
      }
      .path-card {
        background: var(--bg-elevated);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 1.75em;
        text-decoration: none;
        display: flex;
        flex-direction: column;
        gap: 0.75em;
        transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
      }
      .path-card:hover {
        border-color: var(--accent);
        transform: translateY(-2px);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
      }
      .path-card h2 {
        margin: 0;
        font-size: 1.2em;
        color: var(--text-bright);
        line-height: 1.3;
      }
      .path-card .desc {
        color: var(--text-secondary);
        font-size: 0.92em;
        line-height: 1.6;
        margin: 0;
        flex: 1;
      }
      .path-card .audience-label {
        font-size: 0.8em;
        color: var(--text-secondary);
        font-style: italic;
        line-height: 1.4;
        margin: 0;
      }
      .path-meta {
        display: flex;
        align-items: center;
        gap: 0.75em;
        margin-top: auto;
      }
      .post-count {
        font-size: 0.82em;
        color: var(--accent);
        font-weight: 600;
      }
      .path-badge {
        display: inline-flex;
        align-items: center;
        background: rgba(88, 166, 255, 0.1);
        color: var(--accent);
        font-size: 0.72em;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        padding: 0.2em 0.6em;
        border-radius: 20px;
        border: 1px solid rgba(88, 166, 255, 0.3);
        white-space: nowrap;
      }
      .intro-note {
        background: var(--bg-elevated);
        border: 1px solid var(--border);
        border-left: 3px solid var(--accent);
        border-radius: 6px;
        padding: 1em 1.25em;
        margin-bottom: 2.5em;
        font-size: 0.9em;
        color: var(--text-secondary);
        line-height: 1.6;
        max-width: 680px;
      }
      .intro-note strong { color: var(--text-bright); }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <div class="breadcrumb">
        <a href={`${base}/`}>Home</a> › Learning Paths
      </div>

      <div class="page-header">
        <h1>Learning Paths</h1>
        <p>
          {LEARNING_PATHS.length} curated sequences — structured curricula
          that guide you from foundations to advanced techniques in each area of AI security.
        </p>
      </div>

      <div class="intro-note">
        <strong>Why learning paths?</strong> The post collection covers many topics across attack techniques, defenses, and governance.
        Each path below is an ordered sequence curated to build concepts progressively —
        read from first to last for the intended learning arc, or jump to any post directly.
      </div>

      <div class="paths-grid">
        {LEARNING_PATHS.map((path) => (
          <a class="path-card" href={`${base}/learning-paths/${path.slug}/`}>
            <h2>{path.title}</h2>
            <p class="desc">{path.description}</p>
            <p class="audience-label">For: {path.audience.split(",")[0].split(".")[0]}</p>
            <div class="path-meta">
              <span class="post-count">{path.posts.length} posts</span>
              <span class="path-badge">Curated sequence</span>
            </div>
          </a>
        ))}
      </div>
    </main>
    <Footer />
  </body>
</html>
