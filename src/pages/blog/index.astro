---
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Header from "../../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import { CATEGORIES } from "../../data/categories";

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

/** Derive which categories each post belongs to (any tag overlap). */
function getPostCategories(tags: string[]): string[] {
  return CATEGORIES.filter((cat) =>
    cat.tags.some((t) => tags.includes(t))
  ).map((cat) => cat.slug);
}

/**
 * Build a tag→categorySlug map so the client script can look up which
 * category a tag belongs to without importing CATEGORIES at runtime.
 */
const tagToCategorySlug: Record<string, string> = {};
for (const cat of CATEGORIES) {
  for (const tag of cat.tags) {
    tagToCategorySlug[tag] = cat.slug;
  }
}
// Serialize for injection into the client script block.
const TAG_TO_CAT_JSON = JSON.stringify(tagToCategorySlug);

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`All Posts | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
    <style>
      /* ── Filter panel ─────────────────────────────────────────────── */
      .filter-panel {
        background: var(--bg-elevated);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 1.2em 1.4em;
        margin: 1.5em 0 0;
        display: flex;
        flex-direction: column;
        gap: 1.1em;
      }

      /* Search */
      .search-row {
        display: flex;
        gap: 0.6em;
        align-items: center;
      }
      .search-input {
        flex: 1;
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 0.45em 0.8em;
        color: var(--text-bright);
        font-size: 0.95em;
        outline: none;
        transition: border-color 0.15s ease;
      }
      .search-input:focus { border-color: var(--accent); }
      .search-input::placeholder { color: var(--text-secondary); }

      /* Category checkboxes */
      .cat-section-label {
        font-size: 0.82em;
        font-weight: 600;
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 0.5em;
      }
      .cat-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5em 1.2em;
      }
      .cat-label {
        display: flex;
        align-items: center;
        gap: 0.4em;
        font-size: 0.9em;
        color: var(--text-secondary);
        cursor: pointer;
        user-select: none;
        transition: color 0.15s ease;
      }
      .cat-label:hover { color: var(--text-bright); }
      .cat-label input[type="checkbox"] {
        accent-color: var(--accent);
        width: 14px;
        height: 14px;
        cursor: pointer;
      }

      /* Sort row */
      .sort-row {
        display: flex;
        align-items: center;
        gap: 0.5em;
        flex-wrap: wrap;
      }
      .sort-label {
        font-size: 0.85em;
        color: var(--text-secondary);
        margin-right: 0.2em;
      }
      .sort-btn {
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 0.25em 0.7em;
        font-size: 0.85em;
        color: var(--text-secondary);
        cursor: pointer;
        transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
      }
      .sort-btn:hover { border-color: var(--accent); color: var(--text-bright); }
      .sort-btn[aria-pressed="true"] {
        background: var(--accent);
        color: var(--bg);
        border-color: var(--accent);
      }

      /* Status + clear */
      .filter-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 0.5em;
      }
      .filter-status {
        font-size: 0.85em;
        color: var(--text-secondary);
        min-height: 1.2em;
      }
      .clear-btn {
        background: none;
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 0.25em 0.7em;
        font-size: 0.85em;
        color: var(--text-secondary);
        cursor: pointer;
        transition: border-color 0.15s ease, color 0.15s ease;
        display: none;
      }
      .clear-btn:hover { border-color: var(--accent); color: var(--accent); }
      .clear-btn.visible { display: inline-block; }

      /* Post list */
      .post-list { list-style: none; padding: 0; margin: 1.5em 0 0; }
      .post-item {
        padding: 1.2em 0;
        border-bottom: 1px solid var(--border);
      }
      .post-item:last-child { border-bottom: none; }
      .post-item.hidden { display: none; }
      .post-item a.post-link { text-decoration: none; display: block; }
      .post-item h3 {
        margin: 0 0 0.3em;
        font-size: 1.25em;
        color: var(--text-bright);
        transition: color 0.15s ease;
      }
      .post-item a.post-link:hover h3 { color: var(--accent); }
      .post-item .desc {
        color: var(--text-secondary);
        font-size: 0.95em;
        margin: 0 0 0.5em;
      }
      .post-item .meta {
        color: var(--text-secondary);
        font-size: 0.85em;
        display: flex;
        gap: 1em;
        align-items: center;
        flex-wrap: wrap;
      }
      .tag-sm {
        background: var(--bg-elevated);
        color: var(--accent);
        padding: 0.1em 0.5em;
        border-radius: 10px;
        font-size: 0.8em;
        border: 1px solid var(--border);
        text-decoration: none;
        transition: background 0.15s ease, color 0.15s ease;
      }
      .tag-sm:hover { background: var(--accent); color: var(--bg); }
      .tag-sm.active-tag { background: var(--accent); color: var(--bg); border-color: var(--accent); }
      .no-results {
        padding: 2em 0;
        color: var(--text-secondary);
        display: none;
        text-align: center;
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <h1>All Posts</h1>

      <!-- Filter panel -->
      <!-- Embed tag→category map so client script can resolve tags without importing CATEGORIES. -->
      <div class="filter-panel" id="filter-panel" data-tag-to-cat={TAG_TO_CAT_JSON}>

        <!-- Search -->
        <div class="search-row">
          <input
            type="search"
            id="search-input"
            class="search-input"
            placeholder="Search posts…"
            aria-label="Search posts by title or description"
            autocomplete="off"
          />
        </div>

        <!-- Category checkboxes -->
        <div>
          <p class="cat-section-label">Filter by category</p>
          <div class="cat-grid" id="cat-grid">
            {CATEGORIES.map((cat) => (
              <label class="cat-label">
                <input
                  type="checkbox"
                  class="cat-checkbox"
                  data-cat={cat.slug}
                  aria-label={cat.title}
                />
                {cat.title}
              </label>
            ))}
          </div>
        </div>

        <!-- Sort -->
        <div class="sort-row">
          <span class="sort-label">Sort:</span>
          <button class="sort-btn" data-sort="newest" aria-pressed="true">Newest first</button>
          <button class="sort-btn" data-sort="oldest" aria-pressed="false">Oldest first</button>
          <button class="sort-btn" data-sort="alpha"  aria-pressed="false">A → Z</button>
        </div>

        <!-- Status + clear -->
        <div class="filter-footer">
          <p class="filter-status" id="filter-status" aria-live="polite"></p>
          <button class="clear-btn" id="clear-btn" type="button">Clear filters</button>
        </div>

      </div><!-- /filter-panel -->

      <ul class="post-list" id="post-list">
        {posts.map((post) => {
          const words = (post.body ?? "").trim().split(/\s+/).filter(Boolean).length;
          const readingTime = Math.max(1, Math.ceil(words / 200));
          const tags = post.data.tags ?? [];
          const categories = getPostCategories(tags);
          return (
            <li
              class="post-item"
              data-tags={JSON.stringify(tags)}
              data-categories={JSON.stringify(categories)}
              data-title={post.data.title}
              data-date={post.data.pubDate.toISOString()}
              data-desc={post.data.description ?? ""}
            >
              <a class="post-link" href={`${base}/blog/${post.id}/`}>
                <h3>{post.data.title}</h3>
                <p class="desc">{post.data.description}</p>
              </a>
              <div class="meta">
                <FormattedDate date={post.data.pubDate} />
                <span>{readingTime} min read</span>
                {tags.map((tag) => (
                  <a
                    href={`${base}/blog/tags/${encodeURIComponent(tag)}/`}
                    class="tag-sm"
                    data-tag={tag}
                  >{tag}</a>
                ))}
              </div>
            </li>
          );
        })}
      </ul>
      <p class="no-results" id="no-results">No posts match your filters.</p>
    </main>
    <Footer />
  </body>
</html>

<script>
  let _controller: AbortController | null = null;

  function initFilters() {
    const filterPanel = document.getElementById("filter-panel");
    const postList  = document.getElementById("post-list");
    const statusEl  = document.getElementById("filter-status");
    const noResults = document.getElementById("no-results") as HTMLParagraphElement | null;
    const clearBtn  = document.getElementById("clear-btn") as HTMLButtonElement | null;
    const searchEl  = document.getElementById("search-input") as HTMLInputElement | null;

    if (!postList || !searchEl || !filterPanel) return;

    _controller?.abort();
    _controller = new AbortController();
    const { signal } = _controller;

    const allItems = Array.from(postList.querySelectorAll<HTMLLIElement>(".post-item"));
    const checkboxes = Array.from(
      filterPanel.querySelectorAll<HTMLInputElement>(".cat-checkbox")
    );
    const sortBtns = Array.from(
      filterPanel.querySelectorAll<HTMLButtonElement>(".sort-btn")
    );

    // Build-time tag→categorySlug map, injected via data attribute.
    let tagToCat: Record<string, string> = {};
    try { tagToCat = JSON.parse(filterPanel?.dataset.tagToCat ?? "{}"); } catch { tagToCat = {}; }

    const TOTAL = allItems.length;

    // ── State ────────────────────────────────────────────────────────
    let searchQuery  = "";
    let selectedCats = new Set<string>();
    let sortOrder    = "newest";

    // ── Helpers ──────────────────────────────────────────────────────
    function parseCategories(el: HTMLLIElement): string[] {
      try {
        const v = JSON.parse(el.dataset.categories ?? "[]");
        return Array.isArray(v) ? v.filter((x): x is string => typeof x === "string") : [];
      } catch { return []; }
    }

    function matchesSearch(el: HTMLLIElement): boolean {
      if (!searchQuery) return true;
      const q = searchQuery.toLowerCase();
      const title = (el.dataset.title ?? "").toLowerCase();
      const desc  = (el.dataset.desc  ?? "").toLowerCase();
      return title.includes(q) || desc.includes(q);
    }

    function matchesCats(el: HTMLLIElement): boolean {
      if (selectedCats.size === 0) return true;
      const cats = parseCategories(el);
      return cats.some((c) => selectedCats.has(c));
    }

    function safeDate(el: HTMLLIElement): number {
      const t = new Date(el.dataset.date ?? "").valueOf();
      return Number.isFinite(t) ? t : 0;
    }

    function sortedItems(): HTMLLIElement[] {
      const copy = [...allItems];
      if (sortOrder === "oldest") {
        copy.sort((a, b) => safeDate(a) - safeDate(b));
      } else if (sortOrder === "alpha") {
        copy.sort((a, b) => (a.dataset.title ?? "").localeCompare(b.dataset.title ?? ""));
      } else {
        copy.sort((a, b) => safeDate(b) - safeDate(a));
      }
      return copy;
    }

    // ── Apply ────────────────────────────────────────────────────────
    function applyFilters() {
      const ordered = sortedItems();
      // Reorder DOM to match sort
      ordered.forEach((item) => postList!.appendChild(item));

      let visibleCount = 0;
      ordered.forEach((item) => {
        const show = matchesSearch(item) && matchesCats(item);
        item.classList.toggle("hidden", !show);
        if (show) visibleCount++;
      });

      // Highlight tag badges whose OWN tag maps directly to a selected category
      // (not the post's categories, to avoid highlighting unrelated tags on the same post).
      postList!.querySelectorAll<HTMLAnchorElement>(".tag-sm").forEach((link) => {
        const tag = link.dataset.tag ?? "";
        const catForThisTag = tagToCat[tag] ?? "";
        link.classList.toggle(
          "active-tag",
          selectedCats.size > 0 && catForThisTag !== "" && selectedCats.has(catForThisTag)
        );
      });

      // "active data filter" = search or category; sort alone is not a filter
      const hasDataFilter = searchQuery !== "" || selectedCats.size > 0;
      const hasAnything   = hasDataFilter || sortOrder !== "newest";

      if (noResults) noResults.style.display = visibleCount === 0 ? "block" : "none";

      if (statusEl) {
        if (!hasDataFilter) {
          statusEl.textContent = `${TOTAL} posts`;
        } else {
          statusEl.textContent = `Showing ${visibleCount} of ${TOTAL} posts`;
        }
      }

      if (clearBtn) {
        clearBtn.classList.toggle("visible", hasAnything);
      }

      updateURL();
    }

    // ── URL persistence ──────────────────────────────────────────────
    function updateURL() {
      const url = new URL(window.location.href);
      if (searchQuery) {
        url.searchParams.set("q", searchQuery);
      } else {
        url.searchParams.delete("q");
      }
      if (selectedCats.size > 0) {
        url.searchParams.set("category", Array.from(selectedCats).sort().join(","));
      } else {
        url.searchParams.delete("category");
      }
      if (sortOrder !== "newest") {
        url.searchParams.set("sort", sortOrder);
      } else {
        url.searchParams.delete("sort");
      }
      // Always remove the legacy tag param so it never re-appears on state changes.
      url.searchParams.delete("tag");
      history.replaceState(null, "", url.toString());
    }

    function loadFromURL() {
      const url = new URL(window.location.href);
      searchQuery = url.searchParams.get("q") ?? "";

      // Load category param; filter out unknown slugs to prevent dirty URLs.
      const knownCatSlugs = new Set(checkboxes.map((cb) => cb.dataset.cat ?? ""));
      const catParam = url.searchParams.get("category") ?? "";
      selectedCats = catParam
        ? new Set(catParam.split(",").filter((s) => s && knownCatSlugs.has(s)))
        : new Set();

      // Backward-compat: old ?tag= param → look up owning category via build-time map
      // (deterministic, no DOM scan, no post-order dependency).
      const legacyTag = url.searchParams.get("tag") ?? "";
      if (legacyTag) {
        if (selectedCats.size === 0) {
          const catSlug = tagToCat[legacyTag] ?? "";
          if (catSlug && knownCatSlugs.has(catSlug)) selectedCats.add(catSlug);
        }
        // Pre-clean legacy param immediately; updateURL() also removes it on every change.
        url.searchParams.delete("tag");
        history.replaceState(null, "", url.toString());
      }

      sortOrder = url.searchParams.get("sort") ?? "newest";
      if (!["newest", "oldest", "alpha"].includes(sortOrder)) sortOrder = "newest";
    }

    // ── Sync UI controls to state ────────────────────────────────────
    function syncControls() {
      searchEl!.value = searchQuery;
      checkboxes.forEach((cb) => {
        cb.checked = selectedCats.has(cb.dataset.cat ?? "");
      });
      sortBtns.forEach((btn) => {
        btn.setAttribute("aria-pressed", String(btn.dataset.sort === sortOrder));
      });
    }

    // ── Clear ────────────────────────────────────────────────────────
    function clearAll() {
      searchQuery  = "";
      selectedCats = new Set();
      sortOrder    = "newest";
      syncControls();
      applyFilters();
    }

    // ── Event listeners ──────────────────────────────────────────────
    let searchTimer: ReturnType<typeof setTimeout> | null = null;
    // Cancel pending debounce when controller aborts (prevents stale-closure callbacks).
    signal.addEventListener("abort", () => { if (searchTimer) clearTimeout(searchTimer); });
    searchEl.addEventListener("input", () => {
      if (searchTimer) clearTimeout(searchTimer);
      searchTimer = setTimeout(() => {
        searchQuery = searchEl.value.trim();
        applyFilters();
      }, 150);
    }, { signal });

    checkboxes.forEach((cb) => {
      cb.addEventListener("change", () => {
        const slug = cb.dataset.cat ?? "";
        if (cb.checked) selectedCats.add(slug);
        else selectedCats.delete(slug);
        applyFilters();
      }, { signal });
    });

    sortBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        sortOrder = btn.dataset.sort ?? "newest";
        sortBtns.forEach((b) =>
          b.setAttribute("aria-pressed", String(b.dataset.sort === sortOrder))
        );
        applyFilters();
      }, { signal });
    });

    // Tag-badge clicks: plain click filters in-place (activates owning category via
    // tagToCat map); modifier keys (Ctrl/Cmd/Shift) open the tag archive page as normal.
    // Middle-clicks fire `auxclick` not `click`, so they naturally pass through.
    // For tags not covered by CATEGORIES, fall through to the tag archive link normally.
    postList.querySelectorAll<HTMLAnchorElement>(".tag-sm").forEach((link) => {
      link.addEventListener("click", (e) => {
        if (e.ctrlKey || e.metaKey || e.shiftKey) return;
        const tag = link.dataset.tag ?? "";
        if (!tag) return;
        // Look up the category directly from the build-time map (O(1), deterministic).
        const catSlug = tagToCat[tag] ?? "";
        if (!catSlug) return; // tag not in any category → let the link navigate normally
        e.preventDefault();
        selectedCats = new Set([catSlug]);
        syncControls();
        applyFilters();
      }, { signal });
    });

    clearBtn?.addEventListener("click", clearAll, { signal });

    // ── Init ─────────────────────────────────────────────────────────
    loadFromURL();
    syncControls();
    applyFilters();
  }

  document.addEventListener("astro:page-load", initFilters);
  document.addEventListener("DOMContentLoaded", initFilters, { once: true });
</script>
