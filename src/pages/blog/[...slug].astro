---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
const posts = await getCollection('blog', ({ data }) => !data.draft);
const sorted = posts.sort(
(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || a.id.localeCompare(b.id)
);
return sorted.map((post, index) => ({
params: { slug: post.id },
props: {
post,
prevPost: sorted[index + 1] ?? undefined,
nextPost: sorted[index - 1] ?? undefined,
},
}));
}

interface Props {
post: CollectionEntry<'blog'>;
prevPost?: CollectionEntry<'blog'>;
nextPost?: CollectionEntry<'blog'>;
}

const { post, prevPost, nextPost } = Astro.props;
const { Content, headings } = await render(post);
const words = (post.body ?? "").trim().split(/\s+/).filter(Boolean).length;
const minutesRead = Math.max(1, Math.ceil(words / 200));
---

<BlogPost {...post.data} id={post.id} headings={headings} minutesRead={minutesRead} prevPost={prevPost} nextPost={nextPost}>
<Content />
</BlogPost>
