---
import { type CollectionEntry, getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Header from "../../components/Header.astro";
import { SITE_TITLE, WORDS_PER_MINUTE } from "../../consts";
import { CATEGORIES } from "../../data/categories";

export async function getStaticPaths() {
  const allPosts = (await getCollection("blog")).filter((p) => !p.data.draft);
  return CATEGORIES.flatMap((cat) => {
    const catPosts = allPosts
      .filter((p) => cat.tags.some((t) => (p.data.tags ?? []).includes(t)))
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
    if (catPosts.length === 0) return [];
    return [
      {
        params: { slug: cat.slug },
        props: { cat, posts: catPosts },
      },
    ];
  });
}

interface Props {
  cat: (typeof CATEGORIES)[number];
  posts: CollectionEntry<"blog">[];
}

const { cat, posts } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Mark only the oldest posts as foundational (skip badge when category has ≤3 posts)
const FOUNDATIONAL_COUNT = 3;
const foundationalIds: Set<string> =
  posts.length > FOUNDATIONAL_COUNT
    ? new Set<string>(
        [...posts]
          .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf())
          .slice(0, FOUNDATIONAL_COUNT)
          .map((p) => p.id)
      )
    : new Set<string>();
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`${cat.title} | ${SITE_TITLE}`}
      description={cat.description}
    />
    <style>
      .page-header {
        padding: 3em 0 2em;
        border-bottom: 1px solid var(--border);
        margin-bottom: 2.5em;
      }
      .page-header h1 { font-size: 2em; margin: 0 0 0.4em; }
      .page-header p {
        color: var(--text-secondary);
        font-size: 1.05em;
        margin: 0;
        max-width: 600px;
        line-height: 1.6;
      }
      .breadcrumb {
        font-size: 0.9em;
        color: var(--text-secondary);
        margin-bottom: 2em;
      }
      .breadcrumb a {
        color: var(--text-secondary);
        text-decoration: none;
      }
      .breadcrumb a:hover { color: var(--accent); }
      .reading-note {
        background: var(--bg-elevated);
        border: 1px solid var(--border);
        border-left: 3px solid var(--accent);
        border-radius: 6px;
        padding: 1em 1.25em;
        margin-bottom: 2.5em;
        font-size: 0.9em;
        color: var(--text-secondary);
        line-height: 1.6;
      }
      .reading-note strong { color: var(--text-bright); }
      .post-count-label {
        font-size: 0.9em;
        color: var(--text-secondary);
        margin-bottom: 1.5em;
      }
      .post-list { list-style: none; padding: 0; margin: 0 0 4em; }
      .post-item {
        padding: 1.2em 0;
        border-bottom: 1px solid var(--border);
        position: relative;
      }
      .post-item:last-child { border-bottom: none; }
      .post-item a { text-decoration: none; display: block; }
      .post-item h2 {
        margin: 0 0 0.3em;
        font-size: 1.2em;
        color: var(--text-bright);
        transition: color 0.15s ease;
        display: flex;
        align-items: center;
        gap: 0.5em;
        flex-wrap: wrap;
      }
      .post-item a:hover h2 { color: var(--accent); }
      .post-item .desc {
        color: var(--text-secondary);
        font-size: 0.92em;
        margin: 0 0 0.5em;
        line-height: 1.5;
      }
      .post-item .meta {
        color: var(--text-secondary);
        font-size: 0.83em;
        display: flex;
        gap: 1em;
        align-items: center;
        flex-wrap: wrap;
      }
      .foundational-badge {
        display: inline-flex;
        align-items: center;
        background: rgba(var(--accent-rgb, 88, 166, 255), 0.12);
        color: var(--accent);
        font-size: 0.7em;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        padding: 0.15em 0.55em;
        border-radius: 20px;
        border: 1px solid var(--accent);
        white-space: nowrap;
      }
      .tag-sm {
        background: var(--bg-elevated);
        color: var(--accent);
        padding: 0.1em 0.5em;
        border-radius: 10px;
        font-size: 0.85em;
        border: 1px solid var(--border);
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <div class="breadcrumb">
        <a href={`${base}/`}>Home</a> ›
        <a href={`${base}/categories/`}>Browse by Topic</a> ›
        {cat.title}
      </div>

      <div class="page-header">
        <h1>{cat.title}</h1>
        <p>{cat.description}</p>
      </div>

      <div class="reading-note">
        <strong>Suggested reading order:</strong> Posts are listed newest-first so
        you see the latest thinking first. Posts marked
        <span class="foundational-badge">Foundational</span> are early entries that
        introduce core concepts — good starting points if you're new to this area.
      </div>

      <p class="post-count-label">{posts.length} post{posts.length !== 1 ? "s" : ""} in this topic</p>

      <ul class="post-list">
        {posts.map((post) => {
          const words = (post.body ?? "").trim().split(/\s+/).filter(Boolean).length;
          const readingTime = Math.max(1, Math.ceil(words / WORDS_PER_MINUTE));
          const isFoundational = foundationalIds.has(post.id);
          return (
            <li class="post-item">
              <a href={`${base}/blog/${post.id}/`}>
                <h2>
                  {post.data.title}
                  {isFoundational && (
                    <span class="foundational-badge">Foundational</span>
                  )}
                </h2>
                <p class="desc">{post.data.description}</p>
                <div class="meta">
                  <FormattedDate date={post.data.pubDate} />
                  <span>{readingTime} min read</span>
                  {(post.data.tags ?? [])
                    .filter((t) => cat.tags.includes(t))
                    .slice(0, 2)
                    .map((tag) => (
                      <span class="tag-sm">{tag}</span>
                    ))}
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    </main>
    <Footer />
  </body>
</html>
