---
import { getCollection } from "astro:content";
import FormattedDate from "./FormattedDate.astro";

interface Props {
  currentId: string;
  currentTags: string[];
  relatedPosts?: string[];
}

const { currentId, currentTags, relatedPosts } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const allPosts = await getCollection("blog", ({ id, data }) => {
  return !data.draft && id !== currentId;
});

let scored: typeof allPosts;

if (relatedPosts && relatedPosts.length > 0) {
  // Use explicit relatedPosts list when provided; silently drop invalid/draft slugs
  const relatedSet = new Set(relatedPosts);
  const explicit = allPosts
    .filter((post) => relatedSet.has(post.id))
    .sort((a, b) => {
      const idxA = relatedPosts.indexOf(a.id);
      const idxB = relatedPosts.indexOf(b.id);
      return idxA - idxB;
    })
    .slice(0, 3);
  // Fall back to tag-based scoring if all referenced slugs are missing/draft
  if (explicit.length > 0) {
    scored = explicit;
  } else {
    scored = allPosts
      .map((post) => {
        const sharedTags = post.data.tags.filter((t) => currentTags.includes(t));
        return { post, score: sharedTags.length };
      })
      .filter(({ score }) => score > 0)
      .sort((a, b) => {
        if (b.score !== a.score) return b.score - a.score;
        return b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf();
      })
      .slice(0, 3)
      .map(({ post }) => post);
  }
} else {
  // Fall back to tag-based scoring
  scored = allPosts
    .map((post) => {
      const sharedTags = post.data.tags.filter((t) => currentTags.includes(t));
      return { post, score: sharedTags.length };
    })
    .filter(({ score }) => score > 0)
    .sort((a, b) => {
      if (b.score !== a.score) return b.score - a.score;
      return b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf();
    })
    .slice(0, 3)
    .map(({ post }) => post);
}
---

{scored.length > 0 && (
  <aside class="related-posts">
    <h2>You might also like</h2>
    <ul class="related-list">
      {scored.map((post) => (
        <li class="related-item">
          <a href={`${base}/blog/${post.id}/`}>
            <h3>{post.data.title}</h3>
            <p class="related-desc">{post.data.description}</p>
          </a>
          <p class="related-meta">
            <FormattedDate date={post.data.pubDate} />
          </p>
        </li>
      ))}
    </ul>
  </aside>
)}

<style>
  .related-posts {
    margin-top: 3em;
    padding-top: 2em;
    border-top: 1px solid var(--border);
  }
  .related-posts h2 {
    font-size: 1.3em;
    margin: 0 0 1em;
    color: var(--text-bright);
  }
  .related-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1em;
  }
  .related-item {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1em 1.2em;
    transition: border-color 0.15s ease;
  }
  .related-item:hover {
    border-color: var(--accent);
  }
  .related-item a {
    text-decoration: none;
    display: block;
  }
  .related-item h3 {
    margin: 0 0 0.4em;
    font-size: 1.05em;
    color: var(--text-bright);
    transition: color 0.15s ease;
  }
  .related-item a:hover h3 {
    color: var(--accent);
  }
  .related-desc {
    margin: 0;
    font-size: 0.9em;
    color: var(--text-secondary);
    line-height: 1.5;
  }
  .related-meta {
    margin: 0.5em 0 0;
    font-size: 0.82em;
    color: var(--text-secondary);
  }
</style>
