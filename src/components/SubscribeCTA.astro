---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<aside class="subscribe-cta" data-pagefind-ignore>
  <div class="subscribe-inner">
    <div class="subscribe-icon" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 11a9 9 0 0 1 9 9" />
        <path d="M4 4a16 16 0 0 1 16 16" />
        <circle cx="5" cy="19" r="1" />
      </svg>
    </div>
    <div class="subscribe-text">
      <h2 class="subscribe-heading">Stay updated</h2>
      <p class="subscribe-desc">
        New posts on AI security land a few times a month — agent threats, defense patterns,
        practical threat models. Subscribe via RSS and they'll appear in your feed reader
        automatically, no email required.
      </p>
    </div>
    <a href={`${base}/rss.xml`} class="rss-btn" aria-label="Subscribe via RSS feed">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 11a9 9 0 0 1 9 9" />
        <path d="M4 4a16 16 0 0 1 16 16" />
        <circle cx="5" cy="19" r="1" />
      </svg>
      Subscribe via RSS
    </a>
  </div>
</aside>

<style>
  .subscribe-cta {
    margin: 3em 0 1em;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg-surface);
    padding: 1.75em 2em;
  }

  .subscribe-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 1.25em;
  }

  .subscribe-icon {
    color: var(--orange);
    flex-shrink: 0;
    padding-top: 0.2em;
  }

  .subscribe-text {
    flex: 1;
    min-width: 0;
  }

  .subscribe-heading {
    font-size: 1.1em;
    margin: 0 0 0.4em;
    color: var(--text-bright);
  }

  .subscribe-desc {
    color: var(--text-secondary);
    font-size: 0.95em;
    margin: 0;
    line-height: 1.6;
  }

  .rss-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    background: var(--orange);
    color: #0d1117;
    font-weight: 600;
    font-size: 0.9em;
    padding: 0.6em 1.2em;
    border-radius: 6px;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    align-self: center;
    transition: opacity 0.15s ease;
  }

  .rss-btn:hover {
    opacity: 0.85;
    color: #0d1117;
  }

  @media (max-width: 560px) {
    .subscribe-cta {
      padding: 1.25em 1.25em;
    }
    .subscribe-inner {
      flex-direction: column;
    }
    .rss-btn {
      align-self: flex-start;
    }
  }
</style>
